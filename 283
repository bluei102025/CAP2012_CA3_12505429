class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        int n = nums.size();
        int nonZeroPos = 0;
        
        for (int i = 0; i < n; i++) {
            if (nums[i] != 0) {
                nums[nonZeroPos] = nums[i];
                nonZeroPos++;
            }
        }
        while (nonZeroPos < n) {
            nums[nonZeroPos] = 0;
            nonZeroPos++;
        }
    }
};
